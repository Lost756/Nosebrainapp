<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NoseworkJudge" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Основные цвета для тёмной темы -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/black</item>

        <!-- Цвета фона для тёмной темы -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_dark</item>

        <item name="materialThemeOverlay">@style/ThemeOverlay.NoseworkJudge</item>
    </style>

    <style name="ThemeOverlay.NoseworkJudge" parent="ThemeOverlay.Material3.DynamicColors.DayNight">
        <item name="colorSurface">@color/surface_dark</item>
    </style>
</resources>