<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NoseworkJudge" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Основные цвета -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>

        <!-- Цвета фона -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_light</item>

        <!-- Material Components тема -->
        <item name="materialThemeOverlay">@style/ThemeOverlay.NoseworkJudge</item>
    </style>

    <style name="ThemeOverlay.NoseworkJudge" parent="ThemeOverlay.Material3.DynamicColors.DayNight">
        <item name="colorSurface">@color/surface_light</item>
    </style>
</resources>